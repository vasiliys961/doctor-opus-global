# Configure in Vercel Environment Variables, never commit values.
MAST_BENCHMARK_TOKEN=
LLM_API_KEY=
LLM_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Contest-only optional original NIH XRV inference.
# Leave unset for vision-only Gemini/Opus path; NEVER provision GPU.
# Worker server must have pre-provisioned, SHA-256 verified original NIH weights.
# Configure only when permitted to transfer study pixels to this worker.
MAST_XRV_CPU_URL=
MAST_XRV_CPU_TOKEN=
MAST_XRV_CPU_INPUT_RIGHTS_GRANTED=false
MAST_XRV_CPU_WEIGHT_SHA256=31a5475c6b1383a7edbfcaf96af9ce302eb9969cfe28b6b8b5859afc6f274fdf
